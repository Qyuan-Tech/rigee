{
  "name": "@rigee/plugin-api",
  "version": "0.2.0",
  "description": "The contract a Rigee plugin is written against.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "default": "./dist/data.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "cordis": ">=4.0.0-rc.10",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "cordis": { "optional": true },
    "react": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qyuan-Tech/rigee.git",
    "directory": "packages/plugin-api"
  }
}
