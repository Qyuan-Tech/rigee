{
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "plugins/index.ts",
    "plugins/registry.renderer.ts",
    "plugins/shared/**/*",
    "plugins/*/manifest.ts",
    "plugins/*/protocol.ts",
    "plugins/*/renderer/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // vite/client supplies the ?worker / ?url / ?raw import declarations Monaco's workers need.
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@plugins/*": ["plugins/*"]
    }
  }
}
