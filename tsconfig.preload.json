{
  // The preload is its own project because it straddles both worlds: it is bundled as CJS and can
  // reach Electron's Node-side APIs, but it executes in the renderer process and therefore deals
  // in DOM types (MessagePort, MessageEvent). Neither tsconfig.node.json nor tsconfig.web.json
  // describes that combination.
  "include": ["src/preload/**/*", "src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.preload.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] }
  }
}
