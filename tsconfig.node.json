{
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/shared/**/*",
    "packages/plugin-api/src/manifest.ts",
    "packages/plugin-api/src/data.ts",
    "packages/plugin-api/src/context.ts",
    "packages/plugin-api/src/l10n.ts",
    "packages/plugin-api/src/ui.ts",
    "plugins/index.ts",
    "plugins/registry.main.ts",
    "plugins/*/manifest.ts",
    "plugins/*/protocol.ts",
    "plugins/*/types.ts",
    "plugins/*/locales/*",
    "plugins/*/main/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@plugins/*": ["plugins/*"],
      "@rigee/plugin-api": ["packages/plugin-api/src/index.ts"],
      "@rigee/plugin-api/data": ["packages/plugin-api/src/data.ts"],
      "@rigee/plugin-api/manifest": ["packages/plugin-api/src/manifest.ts"],
      "@rigee/plugin-api/context": ["packages/plugin-api/src/context.ts"],
      "@rigee/plugin-api/l10n": ["packages/plugin-api/src/l10n.ts"]
    }
  }
}
