{
  "name": "rigee",
  "version": "0.0.1-alpha.5",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "description": "Agentic IDE: split terminals, Monaco, Chromium tabs, source control",
  "author": {
    "name": "rigee",
    "email": "dev@rigee.local"
  },
  "homepage": "https://github.com/Qyuan-Tech/rigee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qyuan-Tech/rigee.git"
  },
  "license": "MIT",
  "desktopName": "rigee.desktop",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:renderer": "electron-vite dev --rendererOnly",
    "build": "pnpm run typecheck && electron-vite build",
    "typecheck": "tsc -b --force",
    "preview": "electron-vite preview",
    "smoke": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=1 electron .",
    "pack:dir": "pnpm run build && electron-builder --dir --publish never",
    "pack:mac": "pnpm run build && electron-builder --mac --publish never",
    "pack:win": "pnpm run build && electron-builder --win --publish never",
    "pack:linux": "pnpm run build && electron-builder --linux --publish never",
    "pack:all": "pnpm run build && electron-builder -mwl --publish never",
    "git:selftest": "esbuild scripts/git-selftest.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp/git-selftest.mjs --log-level=warning && node node_modules/.tmp/git-selftest.mjs",
    "smoke:terminal": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=terminal electron .",
    "pack:check": "pnpm run build && electron-builder --dir --publish never && env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=1 ./release/$npm_package_version/mac/rigee.app/Contents/MacOS/rigee",
    "install:local": "./scripts/install-local.sh",
    "search:selftest": "esbuild scripts/search-selftest.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp/search-selftest.mjs --log-level=warning && node node_modules/.tmp/search-selftest.mjs",
    "panes:selftest": "esbuild scripts/panetree-selftest.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp/panes-selftest.mjs --log-level=warning && node node_modules/.tmp/panes-selftest.mjs",
    "smoke:split": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=split electron .",
    "smoke:persist": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=persist electron .",
    "smoke:tabs": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=tabs electron .",
    "smoke:quit": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=quit electron .",
    "smoke:shutdown": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=shutdown electron . && echo '[smoke:shutdown] exited cleanly'",
    "smoke:copy": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=copy electron .",
    "smoke:scratch": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=scratch electron .",
    "smoke:scroll": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=scroll electron .",
    "smoke:multirepo": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=multirepo electron .",
    "smoke:mouse": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=mouse electron .",
    "smoke:explorer": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=explorer electron .",
    "perf:check": "esbuild scripts/perf-check.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.tmp/perf-check.mjs --log-level=warning && node node_modules/.tmp/perf-check.mjs",
    "smoke:plugins": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=plugins electron .",
    "smoke:pdf": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=pdf electron .",
    "smoke:migrate": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=migrate electron .",
    "smoke:diskplugin": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=diskplugin electron .",
    "smoke:keys": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=keys electron .",
    "smoke:editing": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=editing electron .",
    "smoke:workspacefiles": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=workspacefiles electron .",
    "smoke:video": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=video electron .",
    "smoke:markdown": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=markdown electron .",
    "smoke:heat": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=heat electron .",
    "smoke:running": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=running electron .",
    "smoke:fileops": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=fileops electron .",
    "smoke:install": "env -u ELECTRON_RUN_AS_NODE RIGEE_SMOKE=install electron .",
    "plugins:selftest": "esbuild scripts/plugins-selftest.ts --bundle --platform=node --format=esm --packages=external --alias:@shared=./src/shared --alias:@rigee/plugin-api/manifest=./packages/plugin-api/src/manifest.ts --outfile=node_modules/.tmp/plugins-selftest.mjs --log-level=warning && node node_modules/.tmp/plugins-selftest.mjs",
    "pack:plugin-api": "rm -rf packages/plugin-api/dist && tsc -p packages/plugin-api/tsconfig.build.json && mkdir -p release && npm pack ./packages/plugin-api --pack-destination release"
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "cordis": "4.0.0-rc.10",
    "electron": "44.4.1",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "monaco-editor": "0.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "zustand": "5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "monaco-editor>dompurify": "3.4.16",
      "@electron/get>global-agent": "4.1.3"
    },
    "supportedArchitectures": {
      "os": [
        "darwin",
        "win32",
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
